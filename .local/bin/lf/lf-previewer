#!/bin/sh

file="$1"
width="${2:-0}"
height="${3:-0}"
x="${4:-0}"
y="${5:-0}"

CACHE_DIR="${HOME}/.cache/lf"
[ -d "$CACHE_DIR" ] || mkdir -p -- "$CACHE_DIR"

# Don't bother if preview pane is too small
if [ "$width" -le 2 ] || [ "$height" -le 2 ]; then
  exit 0
fi

# Debounce graphical previews to avoid thrash while fast-scrolling.
if [ -p "${FIFO_UEBERZUG-}" ]; then
  sleep 0.05
fi

draw() {
  [ -p "${FIFO_UEBERZUG-}" ] || return 0
  path="$(printf '%s' "$1" | sed 's/\\/\\\\/g;s/"/\\"/g')"
  printf '{"action":"add","identifier":"preview","x":%d,"y":%d,"width":%d,"height":%d,"scaler":"contain","scaling_position_x":0.5,"scaling_position_y":0.5,"path":"%s"}\n' \
    "$x" "$y" "$width" "$height" "$path" >"$FIFO_UEBERZUG"
  exit 1
}

ext_of() {
  # derive extension from input path (lowercased); fallback "bin"
  name="$(basename -- "$1")"
  case "$name" in
    *.*) ext="${name##*.}" ;;
    *)   ext="bin" ;;
  esac
  printf '%s' "$ext" | tr '[:upper:]' '[:lower:]'
}

hash() {
  real="$(readlink -f -- "$1" 2>/dev/null || printf '%s' "$1")"
  inode="$(stat -c %i -- "$real" 2>/dev/null || echo 0)"
  mtime="$(stat -c %Y -- "$real" 2>/dev/null || echo 0)"
  key="$(printf '%s\0%s\0%s' "$real" "$inode" "$mtime" | sha256sum | cut -d' ' -f1)"
  ext="$(ext_of "$1")"
  cache="${CACHE_DIR}/${key}.${ext}"
}

cache() {
  # $cache must be set by hash() before calling this.
  if [ ! -f "$cache" ]; then
    "$@"
  fi
  draw "$cache"
}

mime="$(file -Lb --mime-type -- "$file")"
case "$mime" in
  image/*)
    [ -p "${FIFO_UEBERZUG-}" ] || exit 0
    hash "$file"
    cache ln -sf -- "$file" "$cache"
    ;;
  video/*)
    [ -p "${FIFO_UEBERZUG-}" ] || exit 0
    hash "$file"
    cache ffmpegthumbnailer -i "$file" -o "$cache" -s 0
    ;;
  application/pdf)
    [ -p "${FIFO_UEBERZUG-}" ] || exit 0
    hash "$file"
    # PDF preview is a rendered image, so force .jpg cache (pdftoppm outputs <base>.jpg)
    cache="${cache}.jpg"
    cache pdftoppm -jpeg -f 1 -singlefile "$file" "${cache%.jpg}"
    ;;
  application/*zip) atool --list -- "$file" ;;
  #audio/*) mediainfo "$file" || exit 1 ;;
  text/html) lynx -width="$width" -display_charset=utf-8 -dump "$file" ;;
  text/*|*/xml|application/json|application/x-subrip) bat -p --theme gruvbox-dark --terminal-width "$((width-2))" -f "$file" ;;
  *) ;;
esac

file -Lb -- "$file" | fold -s -w "$width"
exit 0
