#!/bin/sh

# Notify function
notify() {
    notify-send -h string:x-dunst-stack-tag:bluetooth "Bluetooth" "$1"
}

# Checks if a device is connected
device_connected() {
    if bluetoothctl info "$1" | grep -F -q "Connected: yes"; then
        return 0
    else
        return 1
    fi
}

# Checks if a device is blocked
device_blocked() {
    if bluetoothctl info "$1" | grep -F -q "Blocked: yes"; then
        return 0
    else
        return 1
    fi
}

# Toggles device connection
toggle_connection() {
    if device_connected "$1"; then
        notify "Trying to disconnect from $2"
        bluetoothctl disconnect "$1" && notify "Disconnected from $2" || notify "Failed to disconnect from $2"
        if ! device_blocked "$1"; then
            bluetoothctl block "$1" && notify "Blocked $2" || notify "Failed to block $2"
        fi
    else
        if device_blocked "$1"; then
            bluetoothctl unblock "$1" && notify "Unblocked $2" || notify "Failed to unblock $2"
        fi
        notify "Trying to connect to $2"
        bluetoothctl connect "$1" && notify "Connected to $2" || notify "Failed to connect to $2"
    fi
}

# Get first device and toggle connection
device="$(bluetoothctl devices | grep -F Device | head -n 1)"
device_name="$(echo "$device" | cut -d ' ' -f 3-)"
mac="$(echo "$device" | cut -d ' ' -f 2)"
toggle_connection "$mac" "$device_name"
